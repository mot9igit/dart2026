# 301 redirects: old dart.agency URLs that have no 1:1 equivalent on the new site.
# Every target below was verified to return HTTP 200 on new.dart.agency.
# Old paths that still resolve identically on the new site (blog categories,
# /kursyi/, /kontaktyi.html, /portfolio/, /politika-konfidenczialnosti.html)
# are intentionally NOT redirected here.

# services: trailing-slash and renamed pages -> *.html
RewriteRule ^uslugi/razrabotka-sajtov/?$ /uslugi/razrabotka-sajtov.html [R=301,L]
RewriteRule ^uslugi/razrabotka-sajtov/dizajn-sajtov\.html$ /uslugi/razrabotka-sajtov.html [R=301,L]
