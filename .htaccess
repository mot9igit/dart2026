RewriteRule ^uslugi/texnicheskaya-podderzhka/texpodderzhka-sajtov-na-modx-revo-evo\.html$ /uslugi/texnicheskaya-podderzhka.html [R=301,L]
RewriteRule ^uslugi/konsultacziya-v-skype\.html$ /uslugi/konsultacziya.html [R=301,L]
RewriteRule ^uslugi/prodvizhenie-sajtov/?$ /uslugi/ [R=301,L]

# company: /kompaniya/* -> /o-kompanii.html
RewriteRule ^kompaniya/?$ /o-kompanii.html [R=301,L]
RewriteRule ^kompaniya/o-nas\.html$ /o-kompanii.html [R=301,L]
RewriteRule ^kompaniya/vakansii\.html$ /o-kompanii.html [R=301,L]
RewriteRule ^kompaniya/vakansiya-veb-razrabotchika-modx\.html$ /o-kompanii.html [R=301,L]

# client area: removed from the new site
RewriteRule ^lichnyij-kabinet/?$ /kontaktyi.html [R=301,L]
RewriteRule ^lichnyij-kabinet/(downloads|istoriya-zakazov|izbrannoe|profil)\.html$ /kontaktyi.html [R=301,L]

# blog article that was not migrated
RewriteRule ^blog/kejsyi/audit-sajta-agentstva-nedvizhimosti\.html$ /blog/kejsyi/ [R=301,L]

# ready-made templates shop: section removed
# component pages have exact equivalents in the components blog category
RewriteRule ^templates/komponentyi-modx/dartlocation\.html$ /blog/komponentyi/81-dartlocation.html [R=301,L]
RewriteRule ^templates/komponentyi-modx/?$ /blog/komponentyi/ [R=301,L]
RewriteRule ^templates/(html|modx-revolution)/?$ /uslugi/razrabotka-sajtov.html [R=301,L]
RewriteRule ^templates/(?!komponentyi-modx/).+\.html$ /uslugi/razrabotka-sajtov.html [R=301,L]
RewriteRule ^templates/?$ /uslugi/razrabotka-sajtov.html [R=301,L]

# portfolio cases that were not migrated (same client keeps its case page)
RewriteRule ^portfolio/medresurs-perm\.html$ /portfolio/medresurs.html [R=301,L]
RewriteRule ^portfolio/(aic|amkar|banditz|bighappy|bk|cruisegid|forum|gnss-oem7|mr|pstm|sajt-npo|sajt-parketgrand|sajt-registratora|sajt-rieltorskogo-agentstva|snegoxod\.ru|tele59)\.html$ /portfolio/ [R=301,L]

# removed service/transactional pages
RewriteRule ^poisk-po-sajtu\.html$ /blog/obuchenie/49-fenomenalnyij-kurs.-chast-14.-poisk-po-sajtu-na-msearch2-na-fenom.html [R=301,L]
RewriteRule ^oformlenie-zakaza\.html$ /blog/obuchenie/28-oformlenie-zakaza-v-minishop2.html [R=301,L]
RewriteRule ^sitemap\.html$ /blog/obuchenie/53-fenomenalnyij-kurs.-chast-18.-robots-sitemap-canonical.html [R=301,L]
RewriteRule ^(onlajn-brif-na-razrabotku-sajta|demo|oplata-proshla-uspeshno|oshibka-pri-sovershenii-platezha)\.html$ /kontaktyi.html [R=301,L]
RewriteRule ^faq\.html$ / [R=301,L]
RewriteRule ^polzovatelskoe-soglashenie\.html$ /politika-konfidenczialnosti.html [R=301,L]


# Prevent rewrite the .well-known directory used by LetsEncrypt by rules below of this rule
RewriteRule "^\.well-known/" - [L]


# Prevent dot directories (hidden directories like .git) to be exposed to the public
# Except for the .well-known directory used by LetsEncrypt a.o
RewriteRule "/\.|^\.(?!well-known/)" - [F]


# Rewrite www.example.com -> example.com -- used with SEO Strict URLs plugin
RewriteCond %{HTTP_HOST} .
RewriteCond %{HTTP_HOST} ^www.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
#
# or for the opposite example.com -> www.example.com use the following
# DO NOT USE BOTH
#
#RewriteCond %{HTTP_HOST} !^$
#RewriteCond %{HTTP_HOST} !^www\. [NC]
#RewriteCond %{HTTP_HOST} (.+)$
#RewriteRule ^(.*)$ https://www.%1/$1 [R=301,L] .


# Force rewrite to https for every host
#RewriteCond %{HTTPS} !=on [OR]
#RewriteCond %{SERVER_PORT} !^443
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


# Redirect the manager to a specific domain - don't rename the ht.access file
# in the manager folder to use this this rule
#RewriteCond %{HTTP_HOST} !^example\.com$ [NC]
#RewriteCond %{REQUEST_URI} ^/manager [NC]
#RewriteRule ^(.*)$ https://example.com/$1 [R=301,L]


# The Friendly URLs part
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?q=$1 [L,QSA]


# For servers that support output compression, you should pick up a bit of
# speed by un-commenting the following lines.

#php_flag zlib.output_compression On
#php_value zlib.output_compression_level 5

