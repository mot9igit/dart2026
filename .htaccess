# MODX supports Friendly URLs via this .htaccess file. You must serve web
# pages via Apache with mod_rewrite to use this functionality, and you must
# change the file name from ht.access to .htaccess.
#
# Make sure RewriteBase points to the directory where you installed MODX.
# E.g., "/modx" if your installation is in a "modx" subdirectory.
#
# You may choose to make your URLs non-case-sensitive by adding a NC directive
# to your rule: RewriteRule ^(.*)$ index.php?q=$1 [L,QSA,NC]

RewriteEngine On
RewriteBase /

# 301 redirects: old dart.agency blog article URLs -> new dart.agency blog URLs
# Rewritten via mod_rewrite (RewriteRule), path-only, same host (new.dart.agency).
# Generated from https://dart.agency/sitemap.xml -> https://new.dart.agency/sitemap.xml
# Old slugs come from the legacy MODX Generation CMS and may contain ! , ( ) etc.

